# Application
APP_NAME=PulseOps
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://pulseops:pulseops_dev@localhost:5432/pulseops
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Monitoring
MAX_CONCURRENT_CHECKS=20
DEFAULT_CHECK_INTERVAL=60
DEFAULT_CHECK_TIMEOUT=10
MIN_CHECK_INTERVAL=30
MAX_CHECK_INTERVAL=900

# SSRF Protection
ALLOW_PRIVATE_NETWORKS=false

# Notifications - Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Notifications - Webhook
WEBHOOK_TIMEOUT=10
WEBHOOK_MAX_RETRIES=3

# Incident Detection
INCIDENT_FAILURE_THRESHOLD=3
INCIDENT_RECOVERY_THRESHOLD=2

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
